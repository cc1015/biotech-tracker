# Copy to sweep/.env and fill in. Keep sweep/.env private.
# SEC asks automated clients to identify themselves: "Your Name your@email"
SEC_USER_AGENT=
# Bluesky post search: your handle + an app password (Settings > Privacy and security > App passwords)
BSKY_HANDLE=
BSKY_APP_PASSWORD=
# Logo.dev publishable key (starts with pk_) for company logos in the front end. Free at https://www.logo.dev
# It ends up inside web/index.html, which is fine for a pk_ key. Never put the secret sk_ key here.
LOGO_DEV_TOKEN=

# fetch_field_scores.py: free key from https://openalex.org/settings/api ($1/day of requests)
OPENALEX_API_KEY=
